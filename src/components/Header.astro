---
// Brand mark: a clean, mostly-white envelope glyph (newsletter motif).
---

<header class="logo-bar">
  <div class="logo-inner">
    <a href="#top" class="logo" aria-label="Your Newsletter Co-Pilot — home">
      <span class="brand-icon" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="34" height="34" role="img">
          <rect x="4" y="9" width="32" height="23" rx="4.5" fill="#fff" />
          <path
            d="M8 13 L20 22 L32 13"
            fill="none"
            stroke="var(--navy)"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
      <span class="brand-name">Your Newsletter Co-Pilot</span>
    </a>
  </div>
</header>

<style>
  .logo-bar {
    padding: 15px var(--section-x);
    background: var(--navy);
    border-bottom: 1px solid var(--border-dark);
  }
  .logo-inner {
    max-width: 1120px;
    margin: 0 auto; /* aligns the mark with the hero's content column */
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }
  .brand-icon {
    display: flex;
    align-items: center;
  }
  .brand-icon svg {
    display: block;
    width: 34px;
    height: 34px;
  }
  .brand-name {
    font-family: 'Space Grotesk Variable', var(--font-body);
    color: #fff;
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  @media (max-width: 880px) {
    .logo-bar {
      padding: 13px var(--section-x);
    }
    .brand-icon svg {
      width: 30px;
      height: 30px;
    }
    .brand-name {
      font-size: 1.05rem;
    }
  }
</style>
