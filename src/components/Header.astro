---
import { Image } from 'astro:assets';
import logo from '@/assets/logo.png';
---

<header class="logo-bar">
  <div class="logo-inner">
    <a href="#top" class="logo" aria-label="Your Newsletter Co-Pilot — home">
      <Image src={logo} alt="Run Your Letter" height={32} class="logo-img" />
      <span class="brand-name">Your Newsletter Co-Pilot</span>
    </a>
  </div>
</header>

<style>
  .logo-bar {
    padding: 15px var(--section-x);
    background: var(--navy);
    border-bottom: 1px solid var(--border-dark);
  }
  .logo-inner {
    max-width: 1120px;
    margin: 0 auto; /* aligns the mark with the hero's content column */
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    text-decoration: none;
  }
  .logo-img {
    height: 32px;
    width: auto;
    display: block;
    filter: brightness(0) invert(1);
  }
  .brand-name {
    font-family: var(--font-body);
    color: #fff;
    font-weight: 700;
    font-size: 1.18rem;
    letter-spacing: -0.02em; /* matches the heading treatment */
    line-height: 1;
    white-space: nowrap;
  }

  @media (max-width: 880px) {
    .logo-bar {
      padding: 13px var(--section-x);
    }
    .logo-img {
      height: 28px;
    }
    .brand-name {
      font-size: 1.02rem;
    }
  }
</style>
