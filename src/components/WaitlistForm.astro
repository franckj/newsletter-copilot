---
// Reusable waitlist form. Used by Hero (stacked) and FinalCTA (row).
// Progressive enhancement: works as a native POST without JS; JS upgrades
// it to an inline fetch. On success, a confirmation overlay covers + blurs
// the form.
import { waitlist } from '@/content/copy';

const HONEYPOT_FIELD = import.meta.env.HONEYPOT_FIELD ?? 'website_url';

interface Props {
  variant?: 'stacked' | 'row';
  ctaLabel: string;
  note?: string;
}

const { variant = 'stacked', ctaLabel, note } = Astro.props;
---

<form
  class:list={['waitlist-form', `waitlist-form--${variant}`]}
  action="/api/waitlist"
  method="post"
>
  <div class="wf-body">
    <!-- Honeypot: hidden from users, tempting to bots. Field name is env-driven. -->
    <div class="hp" aria-hidden="true">
      <label>Leave this field empty
        <input type="text" name={HONEYPOT_FIELD} tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div class="field">
      <label class="visually-hidden" for={`first_name_${variant}`}>First name</label>
      <input
        id={`first_name_${variant}`}
        type="text"
        name="first_name"
        placeholder="First name"
        autocomplete="given-name"
      />
    </div>

    <div class="field">
      <label class="visually-hidden" for={`email_${variant}`}>Email address</label>
      <input
        id={`email_${variant}`}
        type="email"
        name="email"
        placeholder="Email Address"
        autocomplete="email"
        required
      />
    </div>

    <button type="submit" class:list={['btn', 'btn-red', { 'btn-block': variant === 'stacked' }]}>
      {ctaLabel}
    </button>

    {note && <p class="form-note">{note}</p>}

    <p class="form-status" role="status" aria-live="polite" hidden></p>
  </div>

  <!-- Confirmation overlay — revealed on success, covers + blurs the form. -->
  <div class="wf-success" role="status" aria-live="polite">
    <span class="wf-check" aria-hidden="true">
      <svg viewBox="0 0 24 24"><polyline points="5 12.5 10 17.5 19 6.5" /></svg>
    </span>
    <p class="wf-success-title">{waitlist.successTitle}</p>
    <p class="wf-success-sub">{waitlist.successBody}</p>
  </div>
</form>

<style>
  .waitlist-form {
    position: relative;
  }

  .field {
    margin-bottom: 12px;
  }
  .field input {
    width: 100%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-dark);
    border-radius: var(--r-sm);
    padding: 13px 15px;
    font-family: inherit;
    font-size: 0.9rem;
    color: #fff;
    outline: none;
    transition: border-color 0.15s;
  }
  .field input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }
  .field input:focus {
    border-color: var(--pale);
  }

  .form-note {
    text-align: center;
    font-size: 0.74rem;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 12px;
  }

  .form-status {
    margin-top: 14px;
    font-size: 0.85rem;
    line-height: 1.5;
    text-align: center;
  }
  .form-status[data-state='ok'] {
    color: var(--pale);
  }
  .form-status[data-state='err'] {
    color: #ff9db1;
  }

  /* Honeypot — visually removed but present in the DOM for bots. */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* ── Success overlay ── */
  .wf-success {
    display: none;
    position: absolute;
    inset: -8px;
    z-index: 3;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 8px;
    padding: 22px;
    border-radius: 14px;
    background: rgba(8, 7, 45, 0.62);
    -webkit-backdrop-filter: blur(7px);
    backdrop-filter: blur(7px);
  }
  .wf-check {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--red);
    margin-bottom: 2px;
  }
  .wf-check svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: #fff;
    stroke-width: 2.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .wf-success-title {
    font-size: 1.22rem;
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.01em;
  }
  .wf-success-sub {
    font-size: 0.86rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.9);
    max-width: 320px;
  }

  .is-success .wf-body {
    filter: blur(3px);
    opacity: 0.45;
    pointer-events: none;
    user-select: none;
  }
  .is-success .wf-success {
    display: flex;
  }
  /* The row form is short — give the overlay room for the message. */
  .waitlist-form--row.is-success {
    min-height: 172px;
  }

  /* Row variant (Final CTA) */
  .waitlist-form--row .wf-body {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    max-width: 520px;
    margin: 0 auto;
  }
  .waitlist-form--row .field {
    flex: 1 1 180px;
    margin-bottom: 0;
  }
  .waitlist-form--row .field input {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.25);
    padding: 14px 16px;
  }
  .waitlist-form--row .field input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }
  .waitlist-form--row .form-note,
  .waitlist-form--row .form-status {
    flex-basis: 100%;
  }
</style>

<script>
  // Progressive enhancement: intercept submit, POST via fetch, show inline state.
  document.querySelectorAll<HTMLFormElement>('.waitlist-form').forEach((form) => {
    const status = form.querySelector<HTMLParagraphElement>('.form-status');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]');
    const success = form.querySelector<HTMLDivElement>('.wf-success');
    if (!status || !button) return;

    const setStatus = (msg: string, state: 'ok' | 'err') => {
      status.textContent = msg;
      status.dataset.state = state;
      status.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const email = emailInput?.value.trim() ?? '';
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setStatus('Please enter a valid email.', 'err');
        emailInput?.focus();
        return;
      }

      const originalLabel = button.textContent;
      button.disabled = true;
      button.textContent = 'Adding you…';
      status.hidden = true;

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };

        if (res.ok && data.ok) {
          // Reveal the confirmation overlay (covers + blurs the form).
          form.classList.add('is-success');
          if (success) {
            success.setAttribute('tabindex', '-1');
            success.focus();
          }
        } else {
          setStatus(data.error ?? 'Something went wrong. Please try again.', 'err');
          button.disabled = false;
          button.textContent = originalLabel;
        }
      } catch {
        setStatus('Network error. Please try again.', 'err');
        button.disabled = false;
        button.textContent = originalLabel;
      }
    });
  });
</script>
