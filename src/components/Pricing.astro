---
import { pricing, sections } from '@/content/copy';

const s = sections.pricing;
---

<section class="section" id="pricing">
  <div class="section-inner">
    <div class="pricing-top">
      <h2>{s.h2Prefix} <span class="accent">{s.h2Accent}</span></h2>
      <p class="lead pricing-intro">{pricing.intro}</p>
    </div>

    <div class="pricing-card">
      <div class="pricing-main">
        <div class="tier-eyebrow">{pricing.eyebrow}</div>
        <div class="price-row">
          <span class="price">{pricing.price}</span>
          <span class="period">{pricing.period}</span>
        </div>
        <p class="billed">{pricing.billed}</p>
        <a href="#claim-bottom" class="btn btn-red btn-block pricing-cta">{pricing.ctaLabel}</a>
        <p class="pricing-foot">{pricing.scarcity}</p>
      </div>

      <div class="pricing-features">
        <p class="feat-head">{pricing.includedHeading}</p>
        <ul>
          {
            pricing.features.map((f) => (
              <li>
                <span class="check" aria-hidden="true">✓</span>
                <span>{f}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing-top {
    text-align: center;
    margin-bottom: 50px;
  }
  .pricing-intro {
    margin: 0 auto;
    max-width: 760px;
  }

  .pricing-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 960px;
    margin: 0 auto;
    background: linear-gradient(180deg, #1c1b66 0%, #12114f 100%);
    border: 1px solid rgba(219, 28, 74, 0.35);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: 0 24px 60px -30px rgba(219, 28, 74, 0.5);
  }

  .pricing-main {
    padding: 46px 44px;
    border-right: 1px solid var(--border-dark);
    display: flex;
    flex-direction: column;
  }
  .tier-eyebrow {
    color: var(--red);
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: 18px;
  }
  .price-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 12px;
  }
  .price {
    font-size: 3.4rem;
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .period {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--muted-on-dark);
  }
  .billed {
    color: var(--pale);
    font-size: 0.85rem;
    line-height: 1.55;
    margin-bottom: 26px;
    max-width: 320px;
  }
  .pricing-cta {
    font-size: 0.95rem;
    padding: 15px 30px;
    margin-bottom: 18px;
  }
  .pricing-foot {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.82rem;
    text-align: center;
    margin-top: auto;
  }

  .pricing-features {
    padding: 46px 44px;
    background: rgba(0, 0, 0, 0.14);
  }
  .feat-head {
    color: #fff;
    font-weight: 700;
    font-size: 0.98rem;
    margin-bottom: 22px;
  }
  .pricing-features ul {
    list-style: none;
    display: grid;
    gap: 18px;
    padding: 0;
    margin: 0;
  }
  .pricing-features li {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 12px;
    align-items: start;
  }
  .check {
    color: var(--red);
    font-weight: 800;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .pricing-features li span:last-child {
    color: var(--muted-on-dark);
    font-size: 0.93rem;
    line-height: 1.5;
  }

  @media (max-width: 880px) {
    .pricing-card {
      grid-template-columns: 1fr;
      max-width: 460px;
    }
    .pricing-main {
      border-right: none;
      border-bottom: 1px solid var(--border-dark);
    }
  }
</style>
