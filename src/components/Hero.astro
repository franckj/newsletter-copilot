---
import { hero } from '@/content/copy';
import WaitlistForm from './WaitlistForm.astro';
---

<section class="hero" id="top">
  <div class="hero-inner">
    <div class="hero-head">
      {hero.eyebrow && <span class="hero-eyebrow">{hero.eyebrow}</span>}
      <h1>
        {hero.h1Prefix} <span class="accent">{hero.h1Accent}</span> {hero.h1Suffix}
      </h1>

      <div class="hero-pillars">
        {
          hero.pillars.map((p) => (
            <p class="pillar">
              <strong>{p.bold}</strong>
              {p.rest}
            </p>
          ))
        }
      </div>
    </div>

    <p class="hero-desc hero-intro">{hero.intro}</p>

    <div class="hero-form" id="claim">
      <div class="hero-form-title">{hero.formTitle}</div>
      <p class="hero-form-sub">{hero.formSub}</p>
      <WaitlistForm variant="stacked" ctaLabel={hero.formCta} note={hero.formNote} />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 160px var(--section-x) 100px;
    background: var(--navy);
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: -200px;
    right: -200px;
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(155, 185, 249, 0.08) 0%, transparent 65%);
    pointer-events: none;
  }
  /* Desktop: text column on the left, form spanning the right column. */
  .hero-inner {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 400px;
    grid-template-areas:
      'head form'
      'intro form';
    column-gap: 70px;
    row-gap: 0;
    align-items: start;
    position: relative;
    z-index: 1;
  }
  .hero-head {
    grid-area: head;
  }
  .hero-head h1 {
    font-weight: 500;
  }
  .hero-eyebrow {
    display: inline-block;
    background: rgba(155, 185, 249, 0.1);
    border: 1px solid rgba(155, 185, 249, 0.25);
    color: var(--pale-soft);
    font-weight: 700;
    font-size: 0.8rem;
    padding: 7px 16px;
    border-radius: var(--r-full);
    margin-bottom: 20px;
    letter-spacing: 0.01em;
  }
  .hero-intro {
    grid-area: intro;
  }
  /* Form aligns with the headline (drops below the eyebrow row). */
  .hero-form {
    grid-area: form;
    margin-top: 54px;
  }

  .hero-pillars {
    margin: 24px 0 28px;
    display: grid;
    gap: 6px;
  }
  .pillar {
    font-size: 1.12rem;
    color: #fff;
    line-height: 1.85;
    font-weight: 400;
  }
  .pillar strong {
    font-weight: 700;
  }

  .hero-desc {
    font-size: 1.02rem;
    color: var(--muted-on-dark);
    line-height: 1.8;
    max-width: 480px;
    margin-bottom: 10px;
  }

  .hero-form {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-dark);
    border-radius: 12px;
    padding: 34px 30px;
    backdrop-filter: blur(6px);
  }
  .hero-form-title {
    font-weight: 700;
    font-size: 1.08rem;
    color: #fff;
    margin-bottom: 6px;
  }
  .hero-form-sub {
    font-size: 0.83rem;
    color: #fff;
    margin-bottom: 22px;
    line-height: 1.55;
  }

  /* Mobile: single column, form sits directly under the intro paragraph. */
  @media (max-width: 880px) {
    .hero {
      padding: 96px var(--section-x) 60px;
    }
    .hero-inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        'head'
        'form'
        'intro';
      row-gap: 24px;
    }
    .hero-form {
      margin-top: 0;
    }
    .hero-pillars {
      margin: 18px 0 0;
    }
    .hero-intro {
      margin-bottom: 0;
    }
  }
</style>
