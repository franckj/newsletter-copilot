---
import { whatYouGet, sections } from '@/content/copy';

const s = sections.whatYouGet;
---

<section class="section section-light" id="what-you-get">
  <div class="section-inner">
    <h2>{s.h2Prefix} <span class="accent">{s.h2Accent}</span></h2>
    <p class="lead">{whatYouGet.intro}</p>

    <div class="get-grid">
      {
        whatYouGet.items.map((item, i) => (
          <div class="get-card">
            <div class="get-num">{i + 1}</div>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))
      }
    </div>

    <p class="get-extra">{whatYouGet.footnote}</p>
  </div>
</section>

<style>
  .get-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 44px;
  }
  .get-card {
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: 12px;
    padding: 36px 32px;
    color: var(--text-dark);
  }
  .get-num {
    display: inline-block;
    width: 36px;
    height: 36px;
    background: var(--red);
    color: #fff;
    border-radius: 50%;
    text-align: center;
    line-height: 36px;
    font-weight: 800;
    font-size: 0.88rem;
    margin-bottom: 18px;
  }
  .get-card h3 {
    color: var(--navy);
    font-size: 1.15rem;
    margin-bottom: 10px;
  }
  .get-card p {
    color: var(--muted-on-light);
    font-size: 1rem;
    line-height: 1.75;
  }
  .get-extra {
    margin: 32px auto 0;
    text-align: center;
    color: var(--muted-on-light);
    font-size: 1rem;
    max-width: 720px;
    line-height: 1.75;
  }

  @media (max-width: 880px) {
    .get-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
