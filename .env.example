# Kit v3 API key (public "api_key" from Kit → Settings → Advanced → API).
# Used server-side to subscribe via the authenticated v3 API. This BYPASSES
# Kit's form spam-guard, which quarantines datacenter (Cloudflare) POSTs to the
# public widget endpoint. Do NOT switch back to app.kit.com/forms/.../subscriptions.
KIT_API_KEY=

# Kit form numeric ID (find in the v3 forms list, or the embed's data-sv-form).
# Current waitlist form: "Newsletter Co-pilot Waitlist V2" = 9571375.
KIT_FORM_ID=9571375

# Cloudflare Web Analytics token (public)
PUBLIC_CF_ANALYTICS_TOKEN=

# Optional: honeypot field name (randomize per deploy for extra spam protection)
HONEYPOT_FIELD=website_url
